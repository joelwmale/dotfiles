# Use vs to open Cursor (VS Code fork with AI)
vs () { VSCODE_CWD="$PWD" open -n -b "com.microsoft.VSCode" --args $* ;}

# Use fl to open ForkLift at a path (defaults to current directory)
fl() { open -a ForkLift "${1:-.}"; }

v() {
    (cd ~/Code/cli-l && php artisan security:audit)
}

unalias p 2>/dev/null

p() {
    if [[ -f "composer.json" ]]; then
        if composer run --list 2>/dev/null | grep -q "^\s*test\s"; then
            composer run test
        else
            ./vendor/bin/pest
        fi
    else
        echo "No composer.json found in current directory"
        return 1
    fi
}

s() {
   vendor/bin/phpstan analyse --memory-limit=512M
}

gho() {
    # Check if the current directory is a Git repository
    if [[ ! -d .git ]]; then
        echo "Error: Not a Git repository."
        return 1
    fi

    # Extract the 'origin' URL from the .git configuration
    GIT_URL=$(git config --get remote.origin.url)

    # Check if the URL is valid
    if [[ -z "$GIT_URL" ]]; then
        echo "Error: No remote 'origin' URL found."
        return 1
    fi

    # Transform the URL into a browser-friendly format
    # Handle both SSH and HTTPS URLs
    if [[ "$GIT_URL" == git@* ]]; then
        # Convert SSH URL (e.g., git@github.com:org/repo.git) to HTTPS
        BROWSER_URL=$(echo "$GIT_URL" | sed -E 's/git@(.*):/https:\/\/\1\//' | sed 's/\.git$//')
    elif [[ "$GIT_URL" == https://* ]]; then
        # Remove .git if it's an HTTPS URL
        BROWSER_URL=$(echo "$GIT_URL" | sed 's/\.git$//')
    else
        echo "Error: Unsupported remote URL format."
        return 1
    fi

    # Open the URL in the default browser
    echo "Opening $BROWSER_URL..."
    open "$BROWSER_URL"
}

# Open the PR for the current branch in the browser, or offer to create one
pr() {
    if gh pr view --web; then
        return 0
    fi

    printf "No PR found for this branch. Create one now? (Y/n): "
    read createPr
    createPr=${createPr:-y}

    if [[ "$createPr" =~ ^[Yy]$ ]]; then
        gh pr create --web
    fi
}

unalias gss 2>/dev/null  # Remove alias if it exists

gss() {
    local targetDir
    targetDir=$(php ~/Code/cli/swap.php)  # No spaces around '='

    if [ -d "$targetDir" ]; then  # Check if the directory exists
        cd "$targetDir" || return 1
        echo "Switched to $targetDir"
    else
        echo -e "\033[31mError: Target directory does not exist.\033[0m"
        echo "Directory: $targetDir"
    fi
}

composer-link() {
    # Check if the directory is provided and exists
    if [[ -z "$1" || ! -d "$1" ]]; then
        echo "Usage: composer-link <path-to-package-directory>"
        return 1
    fi

    # Define the path to the package's composer.json file
    PACKAGE_COMPOSER_JSON="$1/composer.json"

    # Check if composer.json exists in the given directory
    if [[ ! -f "$PACKAGE_COMPOSER_JSON" ]]; then
        echo "Error: composer.json not found in the specified directory."
        return 1
    fi

    # Extract the 'name' field from the package's composer.json
    PACKAGE_NAME=$(jq -r '.name' "$PACKAGE_COMPOSER_JSON" 2>/dev/null)

    # Verify the name was successfully extracted
    if [[ -z "$PACKAGE_NAME" || "$PACKAGE_NAME" == "null" ]]; then
        echo "Error: Unable to find a valid 'name' in $PACKAGE_COMPOSER_JSON."
        return 1
    fi

    # Add the repository to the current project's composer.json
    composer config repositories.local '{"type": "path", "url": "'"$1"'"}' --file composer.json

    # Run composer require using the extracted package name
    composer require "$PACKAGE_NAME":@dev

    echo "Successfully linked and required package: $PACKAGE_NAME"
}


function tc() {
   if [ -f app/Console/Commands/TestCommand.php ]; then
      pa test:command
   else
      pa make:command TestCommand
      sed -i 's/command:name/test:command/' app/Console/Commands/TestCommand.php
   fi
}

function gitclean()
{
   !f() { local targetBranch=${1:-master} && git checkout -q $targetBranch && git branch --merged | grep -v "\*" | xargs -n 1 git branch -d && git for-each-ref refs/heads/ "--format=%(refname:short)" | while read branch; do mergeBase=$(git merge-base $targetBranch $branch) && [[ $(git cherry $targetBranch $(git commit-tree $(git rev-parse $branch^{tree}) -p $mergeBase -m _)) == "-"* ]] && git branch -D $branch; done; }; f
}

function dc() {
   # work out the docker compose container id using the docker-compose file
   containerId=$(docker-compose ps -q $1)

   # if the container id is empty, then the container is not running
   if [ -z "$containerId" ]; then
      echo "Container $1 is not running"
      return
   fi

   # now start a shell in the container
   docker exec -it $containerId /bin/bash
}

# Create a new directory and enter it
function mkd() {
   mkdir -p "$@" && cd "$@"
}

function weather() {
   ocal city="${1:-Brisbane}"
   curl http://wttr.in/${city// /+}\?F
}

#  Commit everything
function commit() {
  commitMessage="$*"

  git add .

  if [ "$commitMessage" = "" ]; then
     # Start spinner in background (suppress job control messages)
     {
       spinner="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
       while true; do
         for (( i=0; i<${#spinner}; i++ )); do
           printf "\r${spinner:$i:1} Generating commit message..."
           sleep 0.1
         done
       done
     } &!
     spinner_pid=$!

     # Cleanup function for interrupt
     cleanup() {
       { kill $spinner_pid; wait $spinner_pid; } 2>/dev/null
       printf "\r\033[K"
       trap - INT
       return 1
     }
     trap cleanup INT

     # Get diff with size limit, include stat summary for context
     diff_input=$(echo "=== Summary ===" && git diff --cached --stat && echo -e "\n=== Diff (truncated if large) ===" && git diff --cached | head -c 50000)
     commitMessage=$(echo "$diff_input" | claude -p "Write a single-line commit message for this diff. Output ONLY the message, no quotes, no explanation, no markdown.")

     # Stop spinner and clear line
     trap - INT
     { kill $spinner_pid; wait $spinner_pid; } 2>/dev/null
     printf "\r\033[K"

     git commit -m "$commitMessage"
     return
  fi

  eval "git commit -a -m '${commitMessage}'"
}

function release() {
  local BOLD="\033[1m"
  local DIM="\033[2m"
  local GREEN="\033[32m"
  local RED="\033[31m"
  local CYAN="\033[36m"
  local YELLOW="\033[33m"
  local RESET="\033[0m"

  _rel_ok()  { printf "  ${GREEN}✓${RESET} ${1}\n"; }
  _rel_err() { printf "  ${RED}✗${RESET} ${1}\n"; }

  # Check if we're in a git repo
  if [[ ! -d .git ]]; then
    _rel_err "Not a Git repository."
    return 1
  fi

  # Check for unpushed commits
  git fetch --quiet
  LOCAL=$(git rev-parse @)
  REMOTE=$(git rev-parse @{u} 2>/dev/null)

  if [ $? -ne 0 ]; then
    _rel_err "Current branch has no upstream. Please push your branch first."
    return 1
  fi

  if [ "$LOCAL" != "$REMOTE" ]; then
    UNPUSHED=$(git log @{u}..HEAD --oneline 2>/dev/null | wc -l | tr -d ' ')
    if [ "$UNPUSHED" -gt 0 ]; then
      printf "  ${YELLOW}!${RESET} You have ${BOLD}$UNPUSHED${RESET} unpushed commit(s).\n"
      printf "  Push before releasing? (Y/n): "
      read pushConfirm
      pushConfirm=${pushConfirm:-y}

      if [[ "$pushConfirm" =~ ^[Yy]$ ]]; then
        git push --quiet
        if [ $? -ne 0 ]; then
          _rel_err "Failed to push commits."
          return 1
        fi
        _rel_ok "Commits pushed"
      else
        _rel_err "Please push your commits before releasing."
        return 1
      fi
    fi
  fi

  echo ""

  # Get the last release from GitHub
  lastRelease=$(gh release list --limit 1 --json tagName --jq '.[0].tagName' 2>/dev/null)

  if [ -z "$lastRelease" ]; then
    lastVersion="0.0.0"
    printf "  ${DIM}No previous releases found - starting from 0.0.0${RESET}\n"
  else
    lastVersion="${lastRelease#v}"
  fi

  IFS='.' read -r major minor patch <<< "$lastVersion"

  # Show current state and release type menu
  printf "${BOLD}Current version:${RESET} v$lastVersion\n"
  echo ""
  printf "${CYAN}Release type:${RESET}\n"
  printf "  1) Major  ${DIM}(breaking changes)${RESET}\n"
  printf "  2) Minor  ${DIM}(new features)${RESET}\n"
  printf "  3) Patch  ${DIM}(bug fixes)${RESET}\n"
  echo ""
  printf "Select (1-3): "
  read releaseType

  case $releaseType in
    1) major=$((major + 1)); minor=0; patch=0; releaseTypeLabel="Major" ;;
    2) minor=$((minor + 1)); patch=0; releaseTypeLabel="Minor" ;;
    3) patch=$((patch + 1)); releaseTypeLabel="Patch" ;;
    *) _rel_err "Invalid selection"; return 1 ;;
  esac

  newVersion="$major.$minor.$patch"

  echo ""
  printf "${BOLD}New version:${RESET} v$newVersion ${DIM}($releaseTypeLabel)${RESET}\n"
  echo ""
  printf "Confirm? (Y/n): "
  read confirm
  confirm=${confirm:-y}

  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    return 1
  fi

  # Generate release notes
  echo ""

  {
    spinner="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    while true; do
      for (( i=0; i<${#spinner}; i++ )); do
        printf "\r  ${CYAN}${spinner:$i:1}${RESET} Generating release notes..."
        sleep 0.1
      done
    done
  } &!
  spinner_pid=$!

  cleanup() {
    { kill $spinner_pid; wait $spinner_pid; } 2>/dev/null
    printf "\r\033[K"
    trap - INT
    return 1
  }
  trap cleanup INT

  if [ -z "$lastRelease" ]; then
    diffRange="HEAD"; logRange="HEAD"
  else
    diffRange="$lastRelease...HEAD"; logRange="$lastRelease..HEAD"
  fi

  # PRs merged into develop land before the release tag's date, so a date search
  # misses them. Read the PR numbers off merge and squash commits in the range.
  prNumbers=$(git log $logRange --format=%s \
    | sed -nE 's/^Merge pull request #([0-9]+).*/\1/p; s/.*\(#([0-9]+)\)$/\1/p' \
    | sort -un)

  pullRequests=""
  for prNumber in ${(f)prNumbers}; do
    pullRequests+=$(gh pr view "$prNumber" --json number,title,author,body \
      --jq '"--- PR #\(.number) by @\(.author.login): \(.title)\n\(.body // "" | .[0:6000])\n"' 2>/dev/null)
    pullRequests+=$'\n'
  done

  releaseInfo=$(cat <<EOF
=== Pull Requests ===
${pullRequests:-None found}

=== Commits ===
$(git log $logRange --no-merges --format="%h %an: %s")

=== Files Changed ===
$(git diff $diffRange --stat=120 | tail -n 60)
EOF
)

  releaseNotes=$(echo "$releaseInfo" | claude -p "Write release notes for v$newVersion (previous release v$lastVersion) from the pull requests and commits below. They are read by the team and the client to learn what changed, not to audit every commit.

Group by feature, not by commit. Most releases have one to four themes. Give each theme a ### heading named after the feature or area (e.g. \"Messaging\", \"Payouts\"), then two to five bullets on what a user or operator can now do or will notice. Many commits roll up into one bullet.

A fix to something that was built in this same release is part of building it - fold it into that feature, or leave it out. Only call something a fix when it was broken in v$lastVersion. Put those under a final ### Fixes heading, one line each, and only if there are any.

Leave out test-only changes, refactors, renames, internal tooling and dependency bumps, unless one changes how the team works (e.g. a new command they will run). Those go in a single ### Internal bullet list, at most three bullets, and only if they matter.

Each bullet is one short sentence. Say what changed for the user, not how it was built - no security internals, queue names or implementation detail. Leave out deploy steps, env values and infrastructure setup.

Write plainly. No intro or summary paragraph, no version number title, no per-bullet author handles. Use hyphens, never em dashes. If the pull requests have more than one author, end with a ### Contributors list of @handles.

Output only the markdown.")

  trap - INT
  { kill $spinner_pid; wait $spinner_pid; } 2>/dev/null
  printf "\r\033[K"

  # Show release notes preview
  echo ""
  printf "${BOLD}${CYAN}Release Notes Preview${RESET}\n"
  printf "${DIM}────────────────────────────────────────────────────${RESET}\n"
  echo ""
  echo "$releaseNotes"
  echo ""
  printf "${DIM}────────────────────────────────────────────────────${RESET}\n"
  echo ""
  printf "Publish release v$newVersion? (Y/n): "
  read createRelease
  createRelease=${createRelease:-y}

  if [[ ! "$createRelease" =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    return 1
  fi

  echo ""

  {
    spinner="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    while true; do
      for (( i=0; i<${#spinner}; i++ )); do
        printf "\r  ${CYAN}${spinner:$i:1}${RESET} Publishing v$newVersion..."
        sleep 0.1
      done
    done
  } &!
  pub_spinner_pid=$!

  versionBumped=false
  if command -v jq &> /dev/null; then
    # Only bump a version that is already there - never introduce one. npm and
    # Packagist both resolve from git tags, so a version key in the manifest is
    # duplicated state that goes stale, and jq appends a new key at the end of the
    # file, which reorders the manifest on every release.
    if [ -f "package.json" ] && jq -e 'has("version")' package.json > /dev/null 2>&1; then
      jq --arg version "$newVersion" '.version = $version' package.json > package.json.tmp && mv package.json.tmp package.json
      git add package.json
    fi
  fi

  if ! git diff --cached --quiet; then
    git commit --quiet -m "chore: bump version to $newVersion"
    git push --quiet 2>/dev/null
    if [ $? -ne 0 ]; then
      { kill $pub_spinner_pid; wait $pub_spinner_pid; } 2>/dev/null
      printf "\r\033[K"
      _rel_err "Failed to push version bump"
      return 1
    fi
    versionBumped=true
  fi

  echo "$releaseNotes" | gh release create "v$newVersion" \
    --title "v$newVersion" \
    --notes-file - > /dev/null 2>&1
  releaseSuccess=$?

  if [ ! -f "composer.json" ]; then
    floatingTag="v$major"
    git tag -a "$floatingTag" -m "$floatingTag" -f 2>/dev/null
    git push origin "$floatingTag" --force --quiet 2>/dev/null
  fi

  { kill $pub_spinner_pid; wait $pub_spinner_pid; } 2>/dev/null
  printf "\r\033[K"

  echo ""

  if [ $releaseSuccess -eq 0 ]; then
    releaseUrl="$(gh repo view --json url --jq '.url')/releases/tag/v$newVersion"
    _rel_ok "Released ${BOLD}v$newVersion${RESET}"
    [ "$versionBumped" = true ] && _rel_ok "Version bumped"
    printf "  \033[97m${releaseUrl}\033[0m\n"
  else
    _rel_err "Failed to create release"
    return 1
  fi

  echo ""
}

function db () {
   [ ! -f .env ] && { echo "No .env file found."; exit 1; }

   DB_CONNECTION=$(grep DB_CONNECTION .env | grep -v -e '^\s*#' | cut -d '=' -f 2-)
   DB_HOST=$(grep DB_HOST .env | grep -v -e '^\s*#' | cut -d '=' -f 2-)
   DB_PORT=$(grep DB_PORT .env | grep -v -e '^\s*#' | cut -d '=' -f 2-)
   DB_DATABASE=$(grep DB_DATABASE .env | grep -v -e '^\s*#' | cut -d '=' -f 2-)
   DB_USERNAME=$(grep DB_USERNAME .env | grep -v -e '^\s*#' | cut -d '=' -f 2-)
   DB_PASSWORD=$(grep DB_PASSWORD .env | grep -v -e '^\s*#' | cut -d '=' -f 2-)

   DB_URL="${DB_CONNECTION}://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}"

   echo "Opening ${DB_URL}"
   open $DB_URL
}

function scheduler () {
    while :; do
        php artisan schedule:run
	echo "Sleeping 60 seconds..."
        sleep 60
    done
}

function silent() {
   "$@" >& /dev/null
}
